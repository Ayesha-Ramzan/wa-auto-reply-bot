# Copy this file to ".env" and fill in your real values.
# NEVER share your real .env file or upload it to GitHub.

MINIMAX_API_KEY=
MINIMAX_MODEL=minimax-m2.1
MINIMAX_API_URL=http://localhost:8000/v1/chat/completions

# Minimum and maximum delay (in milliseconds) before the bot replies.
# 1000ms = 1 second. This makes replies feel human, not instant.
MIN_DELAY_MS=1500
MAX_DELAY_MS=5000

# ---- STAGED ROLLOUT / TEST MODE ----
# While TEST_MODE=true, the bot will ONLY reply to numbers listed in
# ALLOWED_NUMBERS. Everyone else's messages are saved to memory but
# get NO reply. This lets you safely test with one friend first.
#
# Format for ALLOWED_NUMBERS: full international number, NO plus sign,
# NO spaces, comma-separated if you add more later.
# Example: your friend's number is +92 300 1234567 -> write 923001234567
TEST_MODE=true
ALLOWED_NUMBERS=266700658335971,923213875210,923244060602
