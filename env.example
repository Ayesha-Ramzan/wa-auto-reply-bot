# Copy this file to ".env" and fill in your real values.
# NEVER share your real .env file or upload it to GitHub.

MINIMAX_API_KEY=MINIMAX_API_KEY
MINIMAX_MODEL=minimax-m2.1
MINIMAX_API_URL=http://localhost:8000/v1/chat/completions

# Minimum and maximum delay (in milliseconds) before the bot replies.
# 1000ms = 1 second. This makes replies feel human, not instant.
MIN_DELAY_MS=1500
MAX_DELAY_MS=5000

# While TEST_MODE is true, the bot ONLY replies to numbers in
# config/allowed-numbers.json and/or ALLOWED_NUMBERS below.
# Set to false to open the bot up to everyone.
TEST_MODE=true

# Comma-separated numbers, in addition to config/allowed-numbers.json.
# Digits only, no "+" or "@s.whatsapp.net".
ALLOWED_NUMBERS=

